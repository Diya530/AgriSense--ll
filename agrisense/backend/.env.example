# Copy this file to `.env` in the backend/ folder and fill in real values.
# Never commit your actual .env file.
#
# NOTE: This backend is stateless — no DATABASE_URL, no SECRET_KEY for auth,
# because there's no database and no login. The farmer profile lives in the
# browser (localStorage) and is sent with requests that need it.

# ---------- App ----------
APP_NAME=AgriSense
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM Provider ----------
# One of: gemini | openai | groq | ollama
LLM_PROVIDER=gemini

# Gemini (get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# OpenAI (optional, used if LLM_PROVIDER=openai or as a fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (optional, used if LLM_PROVIDER=groq or as a fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (optional, fully local — no key needed, just run `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------- Weather ----------
# One of: openweathermap | open-meteo
# open-meteo needs NO API key and works out of the box — good for quick testing.
WEATHER_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30

# ---------- Market data (optional) ----------
# Free key from https://data.gov.in (Agmarknet mandi prices). Leave blank to
# use the built-in demo dataset (data/market/demo_prices.json) instead.
DATA_GOV_IN_API_KEY=

# ---------- RAG ----------
KNOWLEDGE_DIR=../data/knowledge
VECTOR_DB_DIR=./vector_store

# ---------- Uploads ----------
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
